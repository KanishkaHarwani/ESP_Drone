# ============================================================
# ESP Drone .gitignore
# ============================================================

# ---------- PlatformIO ----------
.pio/
.pioenvs/
.piolibdeps/
# Generated by PlatformIO IDE integrations
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/
# Keep .vscode/extensions.json if you want to share recommended extensions

# ---------- ESP-IDF (in case you switch frameworks) ----------
build/
sdkconfig.old
managed_components/
dependencies.lock
# sdkconfig is often committed; uncomment to ignore it instead
# sdkconfig

# ---------- Arduino / C++ build artifacts ----------
*.o
*.obj
*.elf
*.bin
*.hex
*.map
*.a
*.lst
*.d

# ---------- Secrets and local config ----------
# Wi-Fi credentials, keys, etc. Commit a secrets.example.h instead.
secrets.h
**/config/secrets.h
*.env
.env

# ---------- Python (tools/) ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---------- KiCad ----------
*-backups/
*.kicad_prl
*-cache.lib
*-rescue.lib
*-rescue.dcm
fp-info-cache
_autosave-*
*.bak
*.kicad_pcb-bak
*.sch-bak
# Generated fabrication output (uncomment if you'd rather not track it)
# hardware/fabrication/

# ---------- CAD / mechanical ----------
*.FCStd1
*.3mf.bak

# ---------- Logs and raw captured data ----------
*.log
*.tmp
# Large raw captures; keep summarized CSVs and notes in data/measurements/
data/raw/

# ---------- Editors and IDEs ----------
.idea/
*.swp
*.swo
*~
.vs/

# ---------- OS files ----------
.DS_Store
Thumbs.db
desktop.ini
